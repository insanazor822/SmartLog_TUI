# sdist (kaynak dağıtımı) içeriği.
#
# `pyproject.toml` + `setuptools` zaten kaynak paketi (smartlog/*.py) ve
# `py.typed` işaretini kapsıyor. Burada yalnızca onun kaçırdıkları ekleniyor.

include LICENSE
include README.md
include CONTRIBUTING.md
include .gitattributes

recursive-include tests *.py
recursive-include benchmarks *.py
recursive-include .github *.yml *.yaml

# Yanlışlıkla sdist'e girmemesi gerekenler
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.so
global-exclude .DS_Store
prune .venv
prune .mypy_cache
prune .ruff_cache
prune .pytest_cache
prune release